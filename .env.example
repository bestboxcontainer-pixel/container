# Modèle des variables d'environnement de Hausgeräte Pfeffer.
#
# En local : copier ce fichier en `.env.local` et remplir les valeurs.
# En production (Hostinger) : saisir ces variables dans le panneau de
# l'application Node.js — le fichier `.env.local` n'est jamais versionné.
#
# Générer un secret aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------------------
# Adresse publique du site — sans barre oblique finale.
# Sert aux URL canoniques, au sitemap, au flux Google Merchant et aux liens
# contenus dans les e-mails. Une valeur fausse casse tous les liens sortants.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hausgeratepfeffer.de

# ---------------------------------------------------------------------------
# Base de données PostgreSQL (Neon). Utiliser la chaîne « pooled » de Neon,
# avec `?sslmode=require`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# ---------------------------------------------------------------------------
# Back-office. Ce compte n'est utilisé que si la table AdminUser est vide :
# c'est un compte d'amorçage. L'adresse doit être une boîte réellement
# relevable, le code de connexion à six chiffres y est envoyé.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=kontakt@hausgeratepfeffer.de
ADMIN_PASSWORD=
# Signature des sessions administrateur (32 octets hexadécimaux)
ADMIN_SESSION_SECRET=

# Signature des sessions clients de la boutique.
# Volontairement distinct du secret du back-office : une session client ne doit
# jamais pouvoir être présentée comme une session administrateur.
CUSTOMER_SESSION_SECRET=

# Chiffrement AES-256-GCM des clés d'intégration stockées en base (32 octets hex)
INTEGRATION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# E-mails transactionnels (codes de connexion, confirmations de commande).
# Boîte Hostinger de la boutique. 465 = SSL implicite.
# Sans ces variables, la connexion au back-office échoue en production.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=kontakt@hausgeratepfeffer.de
SMTP_PASSWORD=
MAIL_FROM=kontakt@hausgeratepfeffer.de
MAIL_FROM_NAME=Hausgeräte Pfeffer

# ---------------------------------------------------------------------------
# Destinataires de la notification « nouvelle commande », séparés par des
# virgules. Facultatif : laissée vide, la notification part vers ADMIN_EMAIL et
# vers les comptes du back-office actifs. Renseignée, elle fait autorité seule —
# c'est le moyen d'envoyer les commandes à une boîte dédiée.
# L'acheteur, lui, est toujours confirmé à l'adresse qu'il a saisie.
# ---------------------------------------------------------------------------
ORDER_NOTIFICATION_EMAILS=

# ---------------------------------------------------------------------------
# Cloudinary : stockage des images produits (voir docs/IMAGES.md).
# Obligatoire en production — sans ces clés, l'envoi d'images est refusé.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Jeton protégeant /api/cron/campaigns, appelé par la tâche planifiée qui
# envoie les campagnes e-mail. Sans lui, la route reste fermée.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Mode maintenance.
#
# En production, la boutique est FERMÉE PAR DÉFAUT : page d'attente en 503 pour
# tout le monde, /admin ouvert pour se connecter, et l'administrateur connecté
# voit le site normalement. Absente ou vide, cette variable ne change rien —
# le site reste fermé.
#
# Pour OUVRIR la boutique au public, il faut le dire explicitement :
#   MAINTENANCE_MODE=0
# puis redémarrer l'application.
#
# En développement, c'est l'inverse : la boutique est ouverte, et MAINTENANCE_MODE=1
# permet de vérifier le rendu de la page d'attente.
# ---------------------------------------------------------------------------
MAINTENANCE_MODE=1

# ---------------------------------------------------------------------------
# Nombre de relais (reverse proxy) placés devant l'application.
#
# Sert à identifier l'appelant pour limiter les essais de codes de réduction.
# L'en-tête x-forwarded-for est complété par chaque relais ; les entrées de
# gauche viennent du client et ne prouvent rien. On saute donc exactement ce
# nombre d'entrées depuis la droite.
#
#   1  derrière Nginx ou Passenger — le cas en production (valeur par défaut)
#   2  derrière un CDN qui ajoute lui aussi son entrée
#   0  application jointe en direct : aucun en-tête n'est cru, et la
#      vérification publique des coupons est alors refusée faute d'identité
#
# Une valeur trop haute laisse le client choisir son identité, une valeur trop
# basse confond tous les visiteurs derrière l'adresse du relais.
# ---------------------------------------------------------------------------
TRUSTED_PROXY_HOPS=1
